# LaundryPro Cloud API Production Environment
# TEMPLATE — Copy to .env.production and fill in real values.
# NEVER commit the actual .env.production file to source control.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-cloud-domain.example.com

# Cloud Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=CHANGE_ME_TO_REAL_PASSWORD

# Alternative prefixed keys (also supported by Env loader)
CLOUD_DB_HOST=localhost
CLOUD_DB_PORT=3306
CLOUD_DB_NAME=your_database_name
CLOUD_DB_USER=your_database_user
CLOUD_DB_PASS=CHANGE_ME_TO_REAL_PASSWORD

# License signing secret (generate a unique 64+ char random string)
LICENSE_MASTER_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHAR_SECRET_KEY

# Session configuration
SESSION_DRIVER=file
SESSION_LIFETIME=120

# CORS
CORS_ALLOWED_ORIGINS=https://your-cloud-domain.example.com
