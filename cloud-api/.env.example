# LaundryPro Cloud API Local Development Environment
# Copy to .env for local cloud testing (https://cloud-api/)

APP_ENV=local
APP_DEBUG=true
APP_URL=https://cloud-api

# Local Development Database (Matches XAMPP MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=laundrypro
DB_USER=root
DB_PASS=

# Production: copy .env.production.example → .env on server (see ../deployment.md)

LICENSE_MASTER_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHAR_SECRET_KEY
