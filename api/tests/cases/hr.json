[
  {
    "name": "hr_employee_create",
    "tag": "HR",
    "setup": "login_as_admin",
    "request": {
      "method": "POST",
      "path": "/employees",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": {
        "employee_no": "EMP-TEST-001",
        "full_name": "Ahmed Al Mansoori",
        "phone": "0500000200",
        "job_title": "Press Operator",
        "base_salary": 3500.00
      }
    },
    "expected": { "status": 201, "success": true, "code": "EMPLOYEE_CREATED" },
    "capture": { "hr_employee_id": "data.employee.id" }
  },
  {
    "name": "hr_attendance_record",
    "tag": "HR",
    "setup": "login_as_admin",
    "requires": ["hr_employee_id"],
    "request": {
      "method": "POST",
      "path": "/attendance",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": {
        "employee_id": "{{hr_employee_id}}",
        "attendance_date": "2026-09-05",
        "status": "present",
        "check_in": "08:00:00",
        "check_out": "17:00:00"
      }
    },
    "expected": { "status": 201, "success": true, "code": "ATTENDANCE_RECORDED" }
  },
  {
    "name": "hr_leave_types_list",
    "tag": "HR",
    "setup": "login_as_admin",
    "request": {
      "method": "GET",
      "path": "/leave-types",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "LEAVE_TYPES_LIST" },
    "capture": { "hr_leave_type_id": "data.leave_types.0.id" }
  },
  {
    "name": "hr_leave_request_create",
    "tag": "HR",
    "setup": "login_as_admin",
    "requires": ["hr_employee_id", "hr_leave_type_id"],
    "request": {
      "method": "POST",
      "path": "/leave-requests",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": {
        "employee_id": "{{hr_employee_id}}",
        "leave_type_id": "{{hr_leave_type_id}}",
        "start_date": "2026-09-15",
        "end_date": "2026-09-16",
        "reason": "Family event"
      }
    },
    "expected": { "status": 201, "success": true, "code": "LEAVE_REQUEST_CREATED" },
    "capture": { "hr_leave_request_id": "data.leave_request.id" }
  },
  {
    "name": "hr_leave_request_approve",
    "tag": "HR",
    "setup": "login_as_admin",
    "requires": ["hr_leave_request_id"],
    "request": {
      "method": "POST",
      "path": "/leave-requests/{{hr_leave_request_id}}/approve",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "notes": "Approved by admin" }
    },
    "expected": { "status": 200, "success": true, "code": "LEAVE_REQUEST_APPROVED" },
    "assert": { "data.leave_request.status": "approved" }
  }
]
