[
  {
    "name": "login_success",
    "tag": "Identity",
    "request": {
      "method": "POST",
      "path": "/auth/login",
      "body": { "username": "admin", "password": "admin123" }
    },
    "expected": { "status": 200, "success": true, "code": "AUTH_LOGIN_SUCCESS" },
    "capture": { "access_token": "data.access_token", "refresh_token": "data.refresh_token" }
  },
  {
    "name": "login_invalid_credentials",
    "tag": "Identity",
    "request": {
      "method": "POST",
      "path": "/auth/login",
      "body": { "username": "admin", "password": "wrong-password" }
    },
    "expected": { "status": 401, "success": false, "code": "AUTH_INVALID_CREDENTIALS" }
  },
  {
    "name": "login_missing_password",
    "tag": "Identity",
    "request": {
      "method": "POST",
      "path": "/auth/login",
      "body": { "username": "admin" }
    },
    "expected": { "status": 422, "success": false, "code": "VALIDATION_ERROR" }
  },
  {
    "name": "refresh_missing_token",
    "tag": "Identity",
    "request": { "method": "POST", "path": "/auth/refresh", "body": {} },
    "expected": { "status": 422, "success": false, "code": "VALIDATION_ERROR" }
  },
  {
    "name": "refresh_invalid_token",
    "tag": "Identity",
    "request": {
      "method": "POST",
      "path": "/auth/refresh",
      "body": { "refresh_token": "invalid.token.value" }
    },
    "expected": { "status": 401, "success": false, "code": "AUTH_SESSION_EXPIRED" }
  },
  {
    "name": "me_unauthorized",
    "tag": "Identity",
    "request": { "method": "GET", "path": "/auth/me" },
    "expected": { "status": 401, "success": false, "code": "AUTH_SESSION_EXPIRED" }
  },
  {
    "name": "me_success",
    "tag": "Identity",
    "request": {
      "method": "GET",
      "path": "/auth/me",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "AUTH_ME_SUCCESS" },
    "requires": ["access_token"]
  },
  {
    "name": "logout_success",
    "tag": "Identity",
    "request": {
      "method": "POST",
      "path": "/auth/logout",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "refresh_token": "{{refresh_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "AUTH_LOGOUT_SUCCESS" },
    "requires": ["access_token", "refresh_token"]
  }
]
