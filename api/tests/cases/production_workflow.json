      "body": { "status": "ready_for_collection" }
    },
    "expected": { "status": 200, "success": true, "code": "SALE_STATUS_UPDATED" },
    "assert": { "data.order.status": "ready_for_collection" }
  },
  {
    "name": "workflow_status_history",
    "tag": "Production",
    "setup": "login_as_admin",
    "requires": ["workflow_order_id"],
    "request": {
      "method": "GET",
      "path": "/sales/{{workflow_order_id}}/status-history",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "SALE_STATUS_HISTORY" }
  }
