    "tag": "Sync",
    "setup": "login_as_admin",
    "request": {
      "method": "GET",
      "path": "/sync/status",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "SYNC_STATUS" }
