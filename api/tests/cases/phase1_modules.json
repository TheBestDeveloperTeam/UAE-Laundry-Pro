  {
    "name": "license_status",
    "tag": "License",
    "setup": "login_as_admin",
    "request": {
      "method": "GET",
      "path": "/license/status",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "LICENSE_STATUS" }
