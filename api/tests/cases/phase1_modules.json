  {
    "name": "service_create_for_sale",
    "tag": "Catalog",
    "setup": "login_as_admin",
    "request": {
      "method": "POST",
      "path": "/services",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "name": "Wash & Fold Test", "base_rate": 25.00 }
    },
    "expected": { "status": 201, "success": true, "code": "SERVICE_CREATED" },
    "capture": { "test_service_id": "data.service.id" }
  },
  {
    "name": "sales_draft_create",
    "tag": "Sales",
    "setup": "login_as_admin",
    "requires": ["test_service_id"],
    "request": {
      "method": "POST",
      "path": "/sales/draft",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": {
        "lines": [
          {
            "item_type": "service",
            "item_id": "{{test_service_id}}",
            "description": "Wash & Fold Test",
            "quantity": 1,
            "rate": 25.00
          }
        ]
      }
    },
    "expected": { "status": 201, "success": true, "code": "SALE_DRAFT_CREATED" },
    "capture": { "test_order_id": "data.order.id" }
  },
  {
    "name": "sales_confirm",
    "tag": "Sales",
    "setup": "login_as_admin",
    "requires": ["test_order_id"],
    "request": {
      "method": "POST",
      "path": "/sales/{{test_order_id}}/confirm",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "SALE_CONFIRMED" }
  },
  {
    "name": "sales_payment",
    "tag": "Sales",
    "setup": "login_as_admin",
    "requires": ["test_order_id"],
    "request": {
      "method": "POST",
      "path": "/sales/{{test_order_id}}/payment",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "amount": 25.00, "payment_method": "cash" }
    },
    "expected": { "status": 200, "success": true, "code": "SALE_PAYMENT_POSTED" }
  },
  {
    "name": "sales_list",
    "tag": "Sales",
    "setup": "login_as_admin",
    "request": {
      "method": "GET",
      "path": "/sales?payment_status=paid",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "SALES_LIST" }
  },
  {
    "name": "sales_status_update",
    "tag": "Sales",
    "setup": "login_as_admin",
    "requires": ["test_order_id"],
    "request": {
      "method": "PATCH",
      "path": "/sales/{{test_order_id}}/status",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "status": "ready" }
    },
    "expected": { "status": 200, "success": true, "code": "SALE_STATUS_UPDATED" }
  },
  {
    "name": "sales_summary",
    "tag": "Reports",
    "setup": "login_as_admin",
    "request": {
      "method": "GET",
      "path": "/reports/sales/summary",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "SALES_SUMMARY" }
  }
]
