[
  {
    "name": "customers_list",
    "tag": "Customers",
    "setup": "login_as_admin",
    "request": {
      "method": "GET",
      "path": "/customers",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "CUSTOMERS_LIST" }
  },
  {
    "name": "customer_create",
    "tag": "Customers",
    "setup": "login_as_admin",
    "request": {
      "method": "POST",
      "path": "/customers",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "name": "Walk-In Test", "phone": "0500000001" }
    },
    "expected": { "status": 201, "success": true, "code": "CUSTOMER_CREATED" }
  },
