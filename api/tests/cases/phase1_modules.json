  {
    "name": "business_get",
    "tag": "Configuration",
    "setup": "login_as_admin",
    "request": {
      "method": "GET",
      "path": "/business",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "BUSINESS_PROFILE" }
