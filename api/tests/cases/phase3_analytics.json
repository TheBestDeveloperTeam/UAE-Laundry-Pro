    "expected": { "status": 200, "success": true, "code": "ANALYTICS_SUMMARY" }
  },
  {
    "name": "p3_analytics_trends",
    "tag": "Phase3",
    "setup": "login_as_admin",
    "request": {
      "method": "GET", "path": "/analytics/trends?metric=sales_total&from=2026-08-01&to=2026-09-05",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "ANALYTICS_TRENDS" }
  },
  {
    "name": "p3_analytics_refresh",
    "tag": "Phase3",
