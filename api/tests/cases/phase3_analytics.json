    "request": { "method": "POST", "path": "/analytics/refresh", "headers": { "Authorization": "Bearer {{access_token}}" } },
    "expected": { "status": 200, "success": true, "code": "ANALYTICS_REFRESHED" }
  },
  {
    "name": "p3_localization_profiles",
    "tag": "Phase3",
    "setup": "login_as_admin",
    "request": { "method": "GET", "path": "/localization/profiles", "headers": { "Authorization": "Bearer {{access_token}}" } },
    "expected": { "status": 200, "success": true, "code": "LOCALIZATION_PROFILES" }
  },
  {
    "name": "p3_localization_set_ksa",
    "tag": "Phase3",
    "setup": "login_as_admin",
    "request": {
      "method": "PUT", "path": "/localization/country",
