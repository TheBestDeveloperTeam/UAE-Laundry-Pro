[
  {
    "name": "settings_unauthorized",
    "tag": "Configuration",
    "request": { "method": "GET", "path": "/settings" },
    "expected": { "status": 401, "success": false, "code": "AUTH_SESSION_EXPIRED" }
  },
  {
    "name": "settings_list",
    "tag": "Configuration",
    "setup": "login_as_admin",
    "request": {
      "method": "GET",
      "path": "/settings",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "SETTINGS_LIST" }
  },
  {
    "name": "settings_update_invalid",
    "tag": "Configuration",
    "setup": "login_as_admin",
    "request": {
      "method": "PUT",
      "path": "/settings",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": {}
    },
    "expected": { "status": 422, "success": false, "code": "VALIDATION_ERROR" }
  },
  {
    "name": "settings_update_success",
    "tag": "Configuration",
    "setup": "login_as_admin",
    "request": {
      "method": "PUT",
      "path": "/settings",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": {
        "settings": {
          "business.name": { "value": "LaundryPro UAE", "scope": "business" }
        }
      }
    },
    "expected": { "status": 200, "success": true, "code": "SETTINGS_UPDATED" }
  }
]
