  {
    "name": "sales_draft_create",
    "tag": "Sales",
    "setup": "login_as_admin",
    "requires": [
      "test_service_id"
    ],
    "request": {
      "method": "POST",
      "path": "/sales/draft",
      "headers": {
        "Authorization": "Bearer {{access_token}}"
      },
      "body": {
        "lines": [
          {
            "item_type": "service",
            "item_id": "{{test_service_id}}",
            "description": "Wash & Fold Test",
            "quantity": 1,
            "rate": 25.0
          }
        ]
      }
    },
    "expected": {
      "status": 201,
      "success": true,
      "code": "SALE_DRAFT_CREATED"
    },
    "capture": {
      "test_order_id": "data.order.id"
    }
  },
