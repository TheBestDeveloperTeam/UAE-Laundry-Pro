[
  {
    "name": "service_create_parent",
    "tag": "Catalog",
    "setup": "login_as_admin",
    "request": {
      "method": "POST",
      "path": "/services",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "name": "Wash Parent", "base_rate": 10 }
    },
    "expected": { "status": 201, "success": true, "code": "SERVICE_CREATED" },
    "capture": { "parent_service_id": "data.service.id" }
  },
  {
    "name": "service_create_child",
    "tag": "Catalog",
    "setup": "login_as_admin",
    "requires": ["parent_service_id"],
    "request": {
      "method": "POST",
      "path": "/services",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "name": "Wash Child", "parent_id": "{{parent_service_id}}", "base_rate": 5 }
    },
    "expected": { "status": 201, "success": true, "code": "SERVICE_CREATED" },
    "capture": { "child_service_id": "data.service.id" }
  },
  {
    "name": "service_cycle_rejected",
    "tag": "Catalog",
    "setup": "login_as_admin",
    "requires": ["parent_service_id", "child_service_id"],
    "request": {
      "method": "PUT",
      "path": "/services/{{parent_service_id}}",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "parent_id": "{{child_service_id}}" }
    },
    "expected": { "status": 422, "success": false, "code": "HIERARCHY_CYCLE" }
  },
  {
    "name": "product_create_for_map",
    "tag": "Catalog",
    "setup": "login_as_admin",
    "request": {
      "method": "POST",
      "path": "/products",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "name": "Detergent", "stock_quantity": 100, "base_rate": 2 }
    },
    "expected": { "status": 201, "success": true, "code": "PRODUCT_CREATED" },
    "capture": { "map_product_id": "data.product.id" }
  },
  {
    "name": "service_product_attach",
    "tag": "Catalog",
    "setup": "login_as_admin",
    "requires": ["parent_service_id", "map_product_id"],
    "request": {
      "method": "POST",
      "path": "/services/{{parent_service_id}}/products",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "product_id": "{{map_product_id}}", "default_qty": 2 }
    },
    "expected": { "status": 201, "success": true, "code": "SERVICE_PRODUCT_ATTACHED" }
  },
  {
    "name": "service_product_list",
    "tag": "Catalog",
    "setup": "login_as_admin",
    "requires": ["parent_service_id"],
    "request": {
      "method": "GET",
      "path": "/services/{{parent_service_id}}/products",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "SERVICE_PRODUCTS" }
  },
  {
    "name": "service_modifier_create",
    "tag": "Catalog",
    "setup": "login_as_admin",
    "requires": ["parent_service_id"],
    "request": {
      "method": "POST",
      "path": "/services/{{parent_service_id}}/modifiers",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "name": "Starch", "extra_rate": 3 }
    },
    "expected": { "status": 201, "success": true, "code": "SERVICE_MODIFIER_CREATED" }
  },
  {
    "name": "service_get_by_id",
    "tag": "Catalog",
    "setup": "login_as_admin",
    "requires": ["parent_service_id"],
    "request": {
      "method": "GET",
      "path": "/services/{{parent_service_id}}",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "SERVICE_DETAIL" }
  },
  {
    "name": "vendor_get_by_id",
    "tag": "Vendors",
    "setup": "login_as_admin",
    "request": {
      "method": "POST",
      "path": "/vendors",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "name": "Supply Co" }
    },
    "expected": { "status": 201, "success": true, "code": "VENDOR_CREATED" },
    "capture": { "vendor_id": "data.vendor.id" }
  },
  {
    "name": "vendor_show",
    "tag": "Vendors",
    "setup": "login_as_admin",
    "requires": ["vendor_id"],
    "request": {
      "method": "GET",
      "path": "/vendors/{{vendor_id}}",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "VENDOR_DETAIL" }
  }
]
