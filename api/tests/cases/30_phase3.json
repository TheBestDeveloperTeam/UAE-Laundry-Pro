[
  {
    "name": "p3_branches_list",
    "tag": "Phase3",
    "setup": "login_as_admin",
    "request": {
      "method": "GET",
      "path": "/branches",
      "headers": {
        "Authorization": "Bearer {{access_token}}"
      }
    },
    "expected": {
      "status": 200,
      "success": true,
      "code": "BRANCHES_LIST"
    },
    "capture": {
      "p3_main_branch_id": "data.branches.0.id",
      "p3_branch_id": "data.branches.0.id"
    }
  },
  {
    "name": "p3_branch_create",
    "tag": "Phase3",
    "setup": "login_as_admin",
    "request": {
      "method": "POST",
      "path": "/branches",
      "headers": {
        "Authorization": "Bearer {{access_token}}"
      },
      "body": {
        "code": "ALN",
        "name": "Al Nahda Branch"
      }
    },
    "expected": {
      "status": 201,
      "success": true,
      "code": "BRANCH_CREATED"
    },
    "capture": {
      "p3_branch_id": "data.branch.id"
    },
    "optional": true
  },
  {
    "name": "p3_branch_show",
    "tag": "Phase3",
    "setup": "login_as_admin",
    "requires": [
      "p3_main_branch_id"
    ],
    "request": {
