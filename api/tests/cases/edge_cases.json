  },
  {
    "name": "sales_payment_partial",
    "tag": "Sales",
    "setup": "login_as_admin",
    "requires": ["edge_draft_id"],
    "request": {
      "method": "POST",
      "path": "/sales/{{edge_draft_id}}/payment",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "amount": 20.00, "payment_method": "cash" }
    },
    "expected": { "status": 200, "success": true, "code": "SALE_PAYMENT_POSTED" },
    "assert": { "data.order.payment_status": "partial", "data.order.balance_due": "30.00" }
  },
  {
    "name": "sales_payment_overpay_capped",
    "tag": "Sales",
    "setup": "login_as_admin",
    "requires": ["edge_draft_id"],
    "request": {
      "method": "POST",
      "path": "/sales/{{edge_draft_id}}/payment",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "amount": 100.00, "payment_method": "cash" }
    },
    "expected": { "status": 200, "success": true, "code": "SALE_PAYMENT_POSTED" },
    "assert": { "data.order.payment_status": "paid", "data.order.balance_due": "0.00" }
  },
