  {
    "name": "me_after_logout",
    "tag": "Identity",
    "reset_admin": true,
    "setup": "login_as_admin",
    "request": {
      "method": "POST",
      "path": "/auth/logout",
      "headers": { "Authorization": "Bearer {{access_token}}" },
