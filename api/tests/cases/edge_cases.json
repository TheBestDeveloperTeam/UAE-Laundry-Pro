[
  {
    "name": "business_unauthorized",
    "tag": "Configuration",
    "request": { "method": "GET", "path": "/business" },
    "expected": { "status": 401, "success": false, "code": "AUTH_SESSION_EXPIRED" }
  },
  {
    "name": "business_update",
    "tag": "Configuration",
    "setup": "login_as_admin",
    "request": {
      "method": "PUT",
      "path": "/business",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "display_name": "LaundryPro UAE Test" }
    },
    "expected": { "status": 200, "success": true, "code": "BUSINESS_UPDATED" }
  },
  {
    "name": "customer_create_missing_name",
    "tag": "Customers",
    "setup": "login_as_admin",
    "request": {
      "method": "POST",
      "path": "/customers",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "phone": "0500000099" }
    },
    "expected": { "status": 422, "success": false, "code": "VALIDATION_ERROR" }
  },
  {
    "name": "customer_get_not_found",
