    "expected": { "status": 422, "success": false, "code": "VALIDATION_ERROR" }
  },
  {
    "name": "products_barcode_unknown",
    "tag": "Catalog",
    "setup": "login_as_admin",
    "request": {
      "method": "GET",
      "path": "/products?barcode=UNKNOWN-BARCODE-XYZ",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "PRODUCTS_LIST" }
  },
  {
    "name": "edge_service_create",
    "tag": "Catalog",
    "setup": "login_as_admin",
    "request": {
      "method": "POST",
      "path": "/services",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "name": "Edge Test Wash", "base_rate": 50.00 }
    },
    "expected": { "status": 201, "success": true, "code": "SERVICE_CREATED" },
    "capture": { "edge_service_id": "data.service.id" }
  },
  {
    "name": "edge_sales_draft",
    "tag": "Sales",
    "setup": "login_as_admin",
    "requires": ["edge_service_id"],
    "request": {
      "method": "POST",
      "path": "/sales/draft",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": {
        "lines": [
          {
            "item_type": "service",
            "item_id": "{{edge_service_id}}",
            "description": "Edge Test Wash",
            "quantity": 1,
            "rate": 50.00
          }
        ]
      }
    },
    "expected": { "status": 201, "success": true, "code": "SALE_DRAFT_CREATED" },
    "capture": { "edge_draft_id": "data.order.id" }
  },
  {
    "name": "sales_payment_on_draft",
    "tag": "Sales",
    "setup": "login_as_admin",
    "requires": ["edge_draft_id"],
    "request": {
      "method": "POST",
      "path": "/sales/{{edge_draft_id}}/payment",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "amount": 50.00, "payment_method": "cash" }
    },
    "expected": { "status": 422, "success": false, "code": "VALIDATION_ERROR" }
  },
  {
    "name": "sales_status_draft_to_ready",
    "tag": "Sales",
    "setup": "login_as_admin",
    "requires": ["edge_draft_id"],
    "request": {
      "method": "PATCH",
      "path": "/sales/{{edge_draft_id}}/status",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "status": "ready" }
    },
    "expected": { "status": 422, "success": false, "code": "VALIDATION_ERROR" }
  },
  {
    "name": "edge_sales_confirm",
    "tag": "Sales",
    "setup": "login_as_admin",
    "requires": ["edge_draft_id"],
    "request": {
      "method": "POST",
      "path": "/sales/{{edge_draft_id}}/confirm",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "SALE_CONFIRMED" },
    "assert": { "data.order.grand_total": "50.00" }
  },
  {
    "name": "sales_confirm_already_confirmed",
    "tag": "Sales",
    "setup": "login_as_admin",
    "requires": ["edge_draft_id"],
    "request": {
      "method": "POST",
      "path": "/sales/{{edge_draft_id}}/confirm",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 422, "success": false, "code": "VALIDATION_ERROR" }
  },
  {
    "name": "sales_payment_zero",
    "tag": "Sales",
    "setup": "login_as_admin",
    "requires": ["edge_draft_id"],
    "request": {
      "method": "POST",
      "path": "/sales/{{edge_draft_id}}/payment",
      "headers": { "Authorization": "Bearer {{access_token}}" },
