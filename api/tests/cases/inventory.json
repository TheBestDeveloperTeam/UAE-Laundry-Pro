[
  {
    "name": "inventory_product_create",
    "tag": "Inventory",
    "setup": "login_as_admin",
    "request": {
      "method": "POST",
      "path": "/products",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "name": "Stock Item", "stock_quantity": 10, "base_rate": 5 }
    },
    "expected": { "status": 201, "success": true, "code": "PRODUCT_CREATED" },
    "capture": { "stock_product_id": "data.product.id" }
  },
  {
    "name": "inventory_receipt",
    "tag": "Inventory",
    "setup": "login_as_admin",
    "requires": ["stock_product_id"],
    "request": {
      "method": "POST",
      "path": "/inventory/receipt",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "product_id": "{{stock_product_id}}", "quantity": 5 }
    },
    "expected": { "status": 201, "success": true, "code": "INVENTORY_RECEIPT" }
  },
  {
    "name": "inventory_movements_list",
    "tag": "Inventory",
    "setup": "login_as_admin",
    "request": {
      "method": "GET",
      "path": "/inventory/movements",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "INVENTORY_MOVEMENTS" }
  },
  {
    "name": "group_service_for_stock",
    "tag": "Inventory",
    "setup": "login_as_admin",
    "requires": ["stock_product_id"],
    "request": {
      "method": "POST",
      "path": "/services",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "name": "Bundle Wash", "is_group": true, "base_rate": 20 }
    },
    "expected": { "status": 201, "success": true, "code": "SERVICE_CREATED" },
    "capture": { "group_service_id": "data.service.id" }
  },
  {
    "name": "group_service_map_product",
    "tag": "Inventory",
    "setup": "login_as_admin",
    "requires": ["group_service_id", "stock_product_id"],
    "request": {
      "method": "POST",
      "path": "/services/{{group_service_id}}/products",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "product_id": "{{stock_product_id}}", "default_qty": 100 }
    },
    "expected": { "status": 201, "success": true, "code": "SERVICE_PRODUCT_ATTACHED" }
  },
  {
    "name": "stock_sale_insufficient",
    "tag": "Inventory",
    "setup": "login_as_admin",
    "requires": ["group_service_id"],
    "request": {
      "method": "POST",
      "path": "/sales/draft",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": {
        "lines": [{ "item_type": "service", "item_id": "{{group_service_id}}", "description": "Bundle", "quantity": 1, "rate": 20 }]
      }
    },
    "expected": { "status": 201, "success": true, "code": "SALE_DRAFT_CREATED" },
    "capture": { "stock_sale_id": "data.order.id" }
  },
  {
    "name": "stock_sale_confirm_blocked",
    "tag": "Inventory",
    "setup": "login_as_admin",
    "requires": ["stock_sale_id"],
    "request": {
      "method": "POST",
      "path": "/sales/{{stock_sale_id}}/confirm",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 422, "success": false, "code": "INSUFFICIENT_STOCK" }
  }
]
