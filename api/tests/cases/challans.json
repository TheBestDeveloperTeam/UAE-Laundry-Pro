[
  {
    "name": "challan_create_first",
    "tag": "Challans",
    "setup": "login_as_admin",
    "request": {
      "method": "POST",
      "path": "/challans",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": {
        "challan_type": "delivery",
        "notes": "First delivery challan",
        "lines": [
          { "description": "Shirts", "quantity": 3, "unit": "pcs" },
          { "description": "Trousers", "quantity": 2, "unit": "pcs" }
        ]
      }
    },
    "expected": { "status": 201, "success": true, "code": "CHALLAN_CREATED" },
    "capture": {
      "challan_id_first": "data.challan.id",
      "challan_no_first": "data.challan.challan_no",
      "challan_seq_first": "data.challan.sequence_no"
    }
  },
  {
    "name": "challan_get_first",
    "tag": "Challans",
    "setup": "login_as_admin",
    "requires": ["challan_id_first"],
    "request": {
      "method": "GET",
      "path": "/challans/{{challan_id_first}}",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "CHALLAN_DETAIL" }
  },
  {
    "name": "challan_create_second",
    "tag": "Challans",
    "setup": "login_as_admin",
    "request": {
      "method": "POST",
      "path": "/challans",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": {
        "challan_type": "delivery",
        "notes": "Second delivery challan",
        "lines": [
          { "description": "Bed sheets", "quantity": 4, "unit": "pcs" }
        ]
      }
    },
    "expected": { "status": 201, "success": true, "code": "CHALLAN_CREATED" },
    "capture": {
      "challan_id_second": "data.challan.id",
      "challan_no_second": "data.challan.challan_no",
      "challan_seq_second": "data.challan.sequence_no"
    }
  },
  {
    "name": "challan_get_second",
    "tag": "Challans",
    "setup": "login_as_admin",
    "requires": ["challan_id_second"],
    "request": {
      "method": "GET",
      "path": "/challans/{{challan_id_second}}",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "CHALLAN_DETAIL" }
  },
  {
    "name": "challan_list_delivery_type",
    "tag": "Challans",
    "setup": "login_as_admin",
    "request": {
      "method": "GET",
      "path": "/challans?challan_type=delivery",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "CHALLANS_LIST" }
  },
  {
    "name": "challan_verify_sequential_no",
    "tag": "Challans",
    "setup": "login_as_admin",
    "requires": ["challan_id_second", "challan_no_first"],
    "request": {
      "method": "GET",
      "path": "/challans/{{challan_id_second}}",
      "headers": { "Authorization": "Bearer {{access_token}}" }
    },
    "expected": { "status": 200, "success": true, "code": "CHALLAN_DETAIL" }
  }
]
