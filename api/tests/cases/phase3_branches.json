[
  {
    "name": "p3_branches_list",
    "tag": "Phase3",
    "setup": "login_as_admin",
    "request": { "method": "GET", "path": "/branches", "headers": { "Authorization": "Bearer {{access_token}}" } },
    "expected": { "status": 200, "success": true, "code": "BRANCHES_LIST" },
    "capture": { "p3_main_branch_id": "data.branches.0.id", "p3_branch_id": "data.branches.0.id" }
  },
  {
    "name": "p3_branch_create",
    "tag": "Phase3",
    "setup": "login_as_admin",
    "request": {
      "method": "POST", "path": "/branches",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "code": "ALN", "name": "Al Nahda Branch" }
    },
    "expected": { "status": 201, "success": true, "code": "BRANCH_CREATED" },
    "capture": { "p3_branch_id": "data.branch.id" },
    "optional": true
  },
  {
    "name": "p3_branch_show",
    "tag": "Phase3",
    "setup": "login_as_admin",
    "requires": ["p3_main_branch_id"],
    "request": { "method": "GET", "path": "/branches/{{p3_main_branch_id}}", "headers": { "Authorization": "Bearer {{access_token}}" } },
    "expected": { "status": 200, "success": true, "code": "BRANCH_DETAIL" }
  },
  {
    "name": "p3_branch_update",
    "tag": "Phase3",
    "setup": "login_as_admin",
    "requires": ["p3_main_branch_id"],
    "request": {
      "method": "PUT", "path": "/branches/{{p3_main_branch_id}}",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "name": "JBR Branch Updated", "is_active": true }
    },
    "expected": { "status": 200, "success": true, "code": "BRANCH_UPDATED" }
  },
  {
    "name": "p3_terminals_list",
    "tag": "Phase3",
    "setup": "login_as_admin",
    "request": { "method": "GET", "path": "/terminals", "headers": { "Authorization": "Bearer {{access_token}}" } },
    "expected": { "status": 200, "success": true, "code": "TERMINALS_LIST" },
    "capture": { "p3_terminal_id": "data.terminals.0.id" }
  },
  {
    "name": "p3_terminal_create",
    "tag": "Phase3",
    "setup": "login_as_admin",
    "requires": ["p3_branch_id"],
    "request": {
      "method": "POST", "path": "/terminals",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "branch_id": "{{p3_branch_id}}", "code": "P3T02", "name": "Counter P3" }
    },
    "expected": { "status": 201, "success": true, "code": "TERMINAL_CREATED" },
    "capture": { "p3_new_terminal_id": "data.terminal.id" },
    "optional": true
  },
  {
    "name": "p3_terminal_register",
    "tag": "Phase3",
    "setup": "login_as_admin",
    "requires": ["p3_new_terminal_id"],
    "optional": true,
    "request": {
      "method": "POST", "path": "/terminals/{{p3_new_terminal_id}}/register",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "device_fingerprint": "test-device-001" }
    },
    "expected": { "status": 201, "success": true, "code": "TERMINAL_REGISTERED" }
  },
  {
    "name": "p3_lan_status",
    "tag": "Phase3",
    "setup": "login_as_admin",
    "request": { "method": "GET", "path": "/lan/status", "headers": { "Authorization": "Bearer {{access_token}}" } },
    "expected": { "status": 200, "success": true, "code": "LAN_NODE_STATUS" }
  },
  {
    "name": "p3_lan_bind",
    "tag": "Phase3",
    "setup": "login_as_admin",
    "request": {
      "method": "PUT", "path": "/lan/bind",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "body": { "bind_host": "0.0.0.0" }
    },
    "expected": { "status": 200, "success": true, "code": "LAN_NODE_CONFIGURED" }
  },
  {
    "name": "p3_sync_entities",
    "tag": "Phase3",
    "setup": "login_as_admin",
    "request": { "method": "GET", "path": "/sync/entities", "headers": { "Authorization": "Bearer {{access_token}}" } },
    "expected": { "status": 200, "success": true, "code": "SYNC_ENTITIES" }
  }
]
