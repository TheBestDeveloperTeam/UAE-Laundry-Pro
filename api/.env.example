APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/laundrypro-api
APP_BASE_PATH=/laundrypro-api/public
APP_VERSION=1.2.0

INSTALL_SECRET=change_this_install_secret_before_production

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=laundrypro
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars_hex
JWT_ACCESS_TTL=28800
JWT_REFRESH_TTL=2592000

BACKUP_PATH=C:/LaundryPro/backups/
INVOICE_PATH=C:/LaundryPro/invoices/
IMAGE_PATH=C:/LaundryPro/images/
LOG_PATH=C:/LaundryPro/logs/
EXPORT_PATH=C:/LaundryPro/exports/

CORS_ALLOWED_ORIGINS=http://localhost
