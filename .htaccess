# LaundryPro UAE Root .htaccess (for cPanel subdomain root pointing to repository root)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forward Authorization header to PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Prevent access to source files, git, and local POS code from web
    RewriteRule ^(\.git|api|lib|windows|test|scripts|database) - [F,L,NC]

    # HTTP deploy bootstrap (FTP-uploaded; token-protected)
    RewriteRule ^cloud-api/public/lp_deploy_apply\.php$ - [L]

    # Route /api/* and /admin/* and cloud traffic directly to cloud-api/public/index.php
    RewriteCond %{REQUEST_URI} ^/api/ [OR]
    RewriteCond %{REQUEST_URI} ^/admin/ [OR]
    RewriteCond %{REQUEST_URI} ^/cloud-api/
    RewriteRule ^ cloud-api/public/index.php [QSA,L]

    # Default root redirect to /admin portal
    RewriteRule ^$ cloud-api/public/index.php [QSA,L]
</IfModule>
